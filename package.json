{
  "name": "indian-insurance-mmrag-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Google Material Design 3 TypeScript Dashboard & Quality Gates for Indian Insurance Multimodal RAG",
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "dev": "node scripts/dev.mjs",
    "check": "node scripts/check.mjs",
    "check:py": "node scripts/check.mjs --py-only",
    "check:ts": "node scripts/check.mjs --ts-only",
    "check:e2e": "node scripts/check.mjs --e2e-only",
    "build": "vite build",
    "lint:ts": "eslint ui/web/src e2e",
    "format:check": "prettier --check \"ui/web/src/**/*.{ts,css}\" \"e2e/**/*.ts\"",
    "format": "prettier --write \"ui/web/src/**/*.{ts,css}\" \"e2e/**/*.ts\"",
    "typecheck:ts": "tsc --noEmit",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.4",
    "eslint": "^9.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
